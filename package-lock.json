/*
# Fix orders: guest checkout, seller visibility, tracking lookup

## Problem
1. `CheckoutPage` inserts `guest_name` / `guest_email` / `guest_phone` on `orders`,
   but those columns never existed — every guest (non-logged-in) checkout failed.
2. `orders` and `order_items` only had INSERT/SELECT policies for the `authenticated`
   role, so even after adding the columns, an anonymous guest checkout would still be
   silently rejected by RLS.
3. Sellers had no SELECT/UPDATE policy on `orders` (or SELECT on `order_items`) at all,
   so the Seller Center "Orders" tab could never show real orders or let a seller
   progress an order's status.
4. There was no safe way for a guest to look up their own order by tracking id without
   exposing the entire `orders` table — this migration adds a SECURITY DEFINER RPC
   scoped to a single tracking id instead of a broad SELECT policy.

## Changes
- Add `guest_name`, `guest_email`, `guest_phone` columns to `orders`.
- Allow anonymous (`anon`) INSERT on `orders` / `order_items` for guest checkout,
  matching the guest UI that already exists in CheckoutPage.
- Allow sellers to SELECT/UPDATE orders that belong to their own store, and SELECT
  the related order_items, via an EXISTS check against `sellers.user_id`.
- Add `get_order_by_tracking(p_tracking_id text)` RPC (SECURITY DEFINER) so the
  delivery-tracking page can look up a single order without a public SELECT policy
  that would leak every customer's order history.
*/

-- ============ GUEST COLUMNS ============
ALTER TABLE orders ADD COLUMN IF NOT EXISTS guest_name text;
ALTER TABLE orders ADD COLUMN IF NOT EXISTS guest_email text;
ALTER TABLE orders ADD COLUMN IF NOT EXISTS guest_phone text;

-- orders.user_id must be nullable for guest orders (it already had no NOT NULL, kept here defensively)
ALTER TABLE orders ALTER COLUMN user_id DROP NOT NULL;

-- ============ GUEST CHECKOUT (anon insert) ============
DROP POLICY IF EXISTS "guest_insert_orders" ON orders;
CREATE POLICY "guest_insert_orders" ON orders FOR INSERT TO anon
  WITH CHECK (user_id IS NULL);

DROP POLICY IF EXISTS "guest_insert_order_items" ON order_items;
CREATE POLICY "guest_insert_order_items" ON order_items FOR INSERT TO anon
  WITH CHECK (true);

-- ============ SELLER ACCESS TO THEIR OWN ORDERS ============
DROP POLICY IF EXISTS "seller_read_own_orders" ON orders;
CREATE POLICY "seller_read_own_orders" ON orders FOR SELECT TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = orders.seller_id AND sellers.user_id = auth.uid()));

DROP POLICY IF EXISTS "seller_update_own_orders" ON orders;
CREATE POLICY "seller_update_own_orders" ON orders FOR UPDATE TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = orders.seller_id AND sellers.user_id = auth.uid()))
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = orders.seller_id AND sellers.user_id = auth.uid()));

DROP POLICY IF EXISTS "seller_read_own_order_items" ON order_items;
CREATE POLICY "seller_read_own_order_items" ON order_items FOR SELECT TO authenticated
  USING (EXISTS (
    SELECT 1 FROM orders
    JOIN sellers ON sellers.id = orders.seller_id
    WHERE orders.id = order_items.order_id AND sellers.user_id = auth.uid()
  ));

-- Admins/superadmins can see and manage all orders (needed for the Admin dashboard)
DROP POLICY IF EXISTS "admin_read_all_orders" ON orders;
CREATE POLICY "admin_read_all_orders" ON orders FOR SELECT TO authenticated
  USING (
    COALESCE((auth.jwt() -> 'user_metadata' ->> 'role'), '') IN ('admin', 'superadmin')
  );

DROP POLICY IF EXISTS "admin_update_all_orders" ON orders;
CREATE POLICY "admin_update_all_orders" ON orders FOR UPDATE TO authenticated
  USING (COALESCE((auth.jwt() -> 'user_metadata' ->> 'role'), '') IN ('admin', 'superadmin'))
  WITH CHECK (COALESCE((auth.jwt() -> 'user_metadata' ->> 'role'), '') IN ('admin', 'superadmin'));

-- ============ TRACKING LOOKUP RPC ============
-- SECURITY DEFINER so it bypasses RLS internally, but only ever returns the single
-- order matching the exact tracking id passed in — never a listing of all orders.
CREATE OR REPLACE FUNCTION get_order_by_tracking(p_tracking_id text)
RETURNS TABLE (
  id uuid, user_id uuid, seller_id uuid, status text, total numeric,
  currency_code text, payment_method text, delivery_address text,
  tracking_id text, created_at timestamptz, order_items jsonb
)
LANGUAGE sql
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT
    o.id, o.user_id, o.seller_id, o.status, o.total, o.currency_code,
    o.payment_method, o.delivery_address, o.tracking_id, o.created_at,
    COALESCE(
      (SELECT jsonb_agg(jsonb_build_object(
        'id', oi.id, 'order_id', oi.order_id, 'product_id', oi.product_id,
        'product_name', oi.product_name, 'qty', oi.qty, 'price', oi.price, 'image_url', oi.image_url
      )) FROM order_items oi WHERE oi.order_id = o.id),
      '[]'::jsonb
    ) AS order_items
  FROM orders o
  WHERE o.tracking_id = p_tracking_id
  LIMIT 1;
$$;

GRANT EXECUTE ON FUNCTION get_order_by_tracking(text) TO anon, authenticated;

-- ============================================================
-- SECURITY: lock down policies that were written as
-- `USING (true) WITH CHECK (true)` for the `authenticated` role.
-- As shipped, this let ANY logged-in account (a regular customer,
-- not just the owning seller or an admin) edit or delete any
-- seller's products/ads, approve/alter any payout, and change
-- platform-wide payment providers. Seller KYC documents were also
-- readable by anyone, including logged-out visitors.
-- ============================================================

CREATE OR REPLACE FUNCTION is_platform_admin()
RETURNS boolean
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public AS $$
  SELECT COALESCE((auth.jwt() -> 'user_metadata' ->> 'role'), '') IN ('admin', 'superadmin');
$$;
GRANT EXECUTE ON FUNCTION is_platform_admin() TO authenticated;

-- ---- products: owner-scoped writes, admin override ----
DROP POLICY IF EXISTS "seller_insert_products" ON products;
CREATE POLICY "seller_insert_products" ON products FOR INSERT TO authenticated
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = products.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
DROP POLICY IF EXISTS "seller_update_products" ON products;
CREATE POLICY "seller_update_products" ON products FOR UPDATE TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = products.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin())
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = products.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
DROP POLICY IF EXISTS "seller_delete_products" ON products;
CREATE POLICY "seller_delete_products" ON products FOR DELETE TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = products.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
-- Sellers must also see their own not-yet-approved/inactive products (public read only shows is_active = true)
DROP POLICY IF EXISTS "seller_read_own_products" ON products;
CREATE POLICY "seller_read_own_products" ON products FOR SELECT TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = products.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());

-- ---- sellers: admins can see/approve every seller, not just approved ones or their own ----
DROP POLICY IF EXISTS "admin_read_all_sellers" ON sellers;
CREATE POLICY "admin_read_all_sellers" ON sellers FOR SELECT TO authenticated USING (is_platform_admin());
DROP POLICY IF EXISTS "admin_update_all_sellers" ON sellers;
CREATE POLICY "admin_update_all_sellers" ON sellers FOR UPDATE TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());

-- ---- seller_documents (KYC): owner + admin only, never public ----
DROP POLICY IF EXISTS "public_read_seller_docs" ON seller_documents;
DROP POLICY IF EXISTS "owner_admin_read_seller_docs" ON seller_documents;
CREATE POLICY "owner_admin_read_seller_docs" ON seller_documents FOR SELECT TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = seller_documents.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
DROP POLICY IF EXISTS "seller_insert_docs" ON seller_documents;
CREATE POLICY "seller_insert_docs" ON seller_documents FOR INSERT TO authenticated
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = seller_documents.seller_id AND sellers.user_id = auth.uid()));
DROP POLICY IF EXISTS "seller_update_docs" ON seller_documents;
CREATE POLICY "seller_update_docs" ON seller_documents FOR UPDATE TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = seller_documents.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin())
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = seller_documents.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());

-- ---- ad_campaigns: owner-scoped writes, admin override ----
DROP POLICY IF EXISTS "auth_insert_ads" ON ad_campaigns;
CREATE POLICY "auth_insert_ads" ON ad_campaigns FOR INSERT TO authenticated
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = ad_campaigns.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
DROP POLICY IF EXISTS "auth_update_ads" ON ad_campaigns;
CREATE POLICY "auth_update_ads" ON ad_campaigns FOR UPDATE TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = ad_campaigns.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin())
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = ad_campaigns.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());

-- ---- payouts: sellers see/request only their own, admins manage all ----
DROP POLICY IF EXISTS "auth_read_payouts" ON payouts;
CREATE POLICY "seller_read_own_payouts" ON payouts FOR SELECT TO authenticated
  USING (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = payouts.seller_id AND sellers.user_id = auth.uid()) OR is_platform_admin());
DROP POLICY IF EXISTS "auth_insert_payouts" ON payouts;
CREATE POLICY "seller_insert_own_payouts" ON payouts FOR INSERT TO authenticated
  WITH CHECK (EXISTS (SELECT 1 FROM sellers WHERE sellers.id = payouts.seller_id AND sellers.user_id = auth.uid()));
DROP POLICY IF EXISTS "auth_update_payouts" ON payouts;
CREATE POLICY "admin_update_payouts" ON payouts FOR UPDATE TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());

-- ---- payment_providers & flash_sales: platform-wide config, admin-only writes ----
DROP POLICY IF EXISTS "auth_manage_payment_providers" ON payment_providers;
CREATE POLICY "admin_manage_payment_providers" ON payment_providers FOR ALL TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());
DROP POLICY IF EXISTS "auth_manage_flash_sales" ON flash_sales;
CREATE POLICY "admin_manage_flash_sales" ON flash_sales FOR ALL TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());

-- ---- platform_settings: admin-only writes (was writable by any authenticated user) ----
DROP POLICY IF EXISTS "authenticated_update_platform_settings" ON platform_settings;
CREATE POLICY "admin_update_platform_settings" ON platform_settings FOR UPDATE TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());
DROP POLICY IF EXISTS "authenticated_insert_platform_settings" ON platform_settings;
CREATE POLICY "admin_insert_platform_settings" ON platform_settings FOR INSERT TO authenticated
  WITH CHECK (is_platform_admin());

-- ---- super_admins: admin-only writes (was writable by any authenticated user) ----
DROP POLICY IF EXISTS "authenticated_manage_super_admins" ON super_admins;
CREATE POLICY "admin_manage_super_admins" ON super_admins FOR ALL TO authenticated
  USING (is_platform_admin()) WITH CHECK (is_platform_admin());

